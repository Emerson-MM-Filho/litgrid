{
  "name": "@ampulla/litgrid",
  "version": "0.2.0",
  "description": "A canvas grid of cells that lights up with the scene: the CRT/LED panel look, framework-agnostic.",
  "keywords": [
    "canvas",
    "grid",
    "crt",
    "led",
    "pixel",
    "glow",
    "light",
    "cursor",
    "magnet",
    "hero",
    "background",
    "effect",
    "framework-agnostic"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/litgrid.js",
  "module": "./dist/litgrid.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/litgrid.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/litgrid.iife.js",
  "jsdelivr": "./dist/litgrid.iife.js",
  "sideEffects": false,
  "files": [
    "dist/litgrid.js",
    "dist/litgrid.iife.js",
    "dist/*.d.ts",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ampulla-tech/litgrid.git"
  },
  "homepage": "https://ampulla-tech.github.io/litgrid/",
  "bugs": {
    "url": "https://github.com/ampulla-tech/litgrid/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config vite.app.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:app": "vite build --config vite.app.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p fixtures/types/tsconfig.json && tsc -p examples/tsconfig.json",
    "test": "playwright test",
    "build:examples": "vite build -c examples/react/vite.config.ts && vite build -c examples/vue/vite.config.ts && vite build -c examples/ssr/vite.config.ts",
    "check:readme": "node scripts/check-readme.mjs",
    "prepack": "npm run build",
    "docs:media": "npm run build && node scripts/docs-media.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vue": "^3.5.44"
  }
}
